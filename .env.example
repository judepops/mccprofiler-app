# Copy this file to `.env` and fill in ONE key. `.env` is gitignored and never
# committed.
#
#     cp .env.example .env
#     # edit .env, then restart the backend
#
# Only the plain-English "find a gene by describing it" box uses a model.
# Everything else, including building and running queries by hand, works with no
# key at all.

# Which provider to use: gemini (default, free tier) or claude
LLM_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override. Ids move faster than this file does, so if the
# default 404s, set the current one here.
# GEMINI_MODEL=gemini-2.0-flash

# Only needed if LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
